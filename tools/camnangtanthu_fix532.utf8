function OpenShop()
	local	nKNB	=	nKNB_NhatKy
	if	(CFG_ShopItemThuPhi	== 0)	then
		Talk(1, "", "Hiện tại không m.")
		return 0				
	else
	local szTitlez =  "<color=yellow>V Lâm Truyền K 1 - 2009<color> - <color=blue>Phong Hỏa Liên Thành!.<color>\nGửi qu nhân s thân mến! Tuy l Server miễn ph, tuy nhiên để c chất lượng ổn định nhất cho mọi người chơi. Team đã đầu t Server v các ph ph để vận hành cho toàn máy ch dùng chung.  đây không ép buộc bất k ai phải Donate v cũng để đáp l Anh Em ủng h th máy ch c bán một s vật phẩm để Anh Em qu mến ủng h cho Server c kinh ph duy tr hàng tháng!\n<color=wood>   1. Nhất k càn khôn ph (30 ngày) gi "..nKNB.." Kim Nguyên Bảo với các thuộc tính sau:<color>\n<color=cyan>     - Tăng +1 cấp k năng vốn c<color>\n<color=cyan>     - Phục hồi sinh lực nội lực 50 điểm<color>\n<color=cyan>     - Tăng kháng tấc c + 10%<color>\n<color=cyan>     - x2 Điểm kinh nghiệm luyện công<color>"
		local tbOpt =
		{
		{"Mua Nhất K (30 ngày)", pay_NhatKy},
		{"Mua Thần Hành Phù (30 ngày)", pay_THP},
		{"Mua Th Địa Ph (30 ngày)", pay_TDP},
		{"Mua D Tẩu Lệnh bài", pay_DTLB},
		{"Mua Lệnh Bài Thủy Tặc", pay_LBTT},
		--{"Mua Tâm Tâm Tương ánh Ph (30 ngày)", pay_TTTAP},
		{"Thoát"},
		}
		CreateNewSayEx(szTitlez, tbOpt)	
	return 1				
	end
end

function pay_LBTT()
	local nTD = nTD_LBTT
	Buy_LBTT(nTD)
end
function Buy_LBTT(nNedCount)
	local nTD = nTD_LBTT
	if (nNedCount < nTD or nNedCount == nil) then
		print("Fail!!!!");
		return
	end;
	if CalcFreeItemCellCount() < 2 then 
		Say("Bán hàng rong: Xin hãy sắp xếp lại hành trang!",0);
		return 0;
	end
	local nCount = CalcEquiproomItemCount(4, 417, 1, 1)

	if (nCount < nNedCount) then
		Talk(1,"","Khách quan chưa đủ <color=yellow>"..nTD.." Tiền Đồng<color>! Khi nào c đủ <color=yellow>"..nTD.." Tiền Đồng<color> hãy quay lại. ")
		return 1;
	end
	ConsumeEquiproomItem(nNedCount, 4, 417, 1, 1)
	local tbItem ={szName="Lệnh Bài Thủy Tặc",tbProp={6,1,2745,1,0,0},nCount=1,nExpiredTime=1440*30,nBindState = -2}
		tbAwardTemplet:GiveAwardByList(tbItem, "Lệnh Bài Thủy Tặc", 1)
	return 0;

end

