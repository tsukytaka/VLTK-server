			{"Kết thúc dối thoại",No},
		}
	tbOpt = tbItemFeatureConfig:FilterOptions(tbOpt, "starter.forge", {"purple","reroll","platinum","refine_gold","refine_guild","craft_gold","exchange_fragment","level","indestructible","",""}, 0);
	CreateNewSayEx("<npc><color=green>Ta đây có nhiều sự lựa chọn cho "..GetName().." , ngươi muốn làm gì ?<color>", tbOpt)
end

function NangCapKhongThePhaHuy()

	local szTitle = 
		"Nâng cấp độ bền trang bị thành không thể phá hủy.<enter><enter>"..
		"Giá nâng cấp : <color=yellow>100 vạn lượng x cấp độ trang bị<color>"

	local tbOpt = {}
	tinsert(tbOpt, {"Tiến hành nâng cấp", GiveItemUI_NangCapKhongThePhaHuy})
	tinsert(tbOpt, {"Đóng", no})

	CreateNewSayEx(szTitle, tbOpt)
end

------------------------------------------------

function GiveItemUI_NangCapKhongThePhaHuy()

	GiveItemUI(
		"Nâng cấp độ bền trang bị",
		"Đặt 1 trang bị vào để nâng cấp.<enter><enter>"..
		"+ Chỉ 1 trang bị mỗi lần.<enter>"..
		"+ Giá : 100 vạn lượng x cấp độ trang bị.",
		"GiveItemUI_NangCapKhongThePhaHuy_OK",
		nil,
		1
	)
end

------------------------------------------------

function GiveItemUI_NangCapKhongThePhaHuy_OK(nCount)
	if (nCount ~= 1) then
		Talk(1, "", "Chỉ được nâng cấp 1 trang bị mỗi lần.")
		return
	end

	local nIdx = GetGiveItemUnit(1)
	if (not nIdx or nIdx <= 0) then
		Talk(1, "", "Không nhận được trang bị.")
		return
	end

	local itemLevel = GetItemLevel(nIdx)
	local itemName  = GetItemName(nIdx)
	local durability = GetCurDurability(nIdx)
	local G, D, P = GetItemProp(nIdx)

	if (G == 6 or G == 4 or G == 1 or G == 7) then
		Talk(1, "", "Chỉ nâng cấp được trang bị (trắng, xanh, tím, bạch kim).")
		return
	end

	if (durability == -1) then
		Talk(1, "", "Trang bị này đã là không thể phá hủy.")
		return
	end

	local nMoney = 1000000 * itemLevel

	if (GetCash() < nMoney) then
		Talk(1, "", "Không đủ ngân lượng để nâng cấp.")
		return
	end

	Pay(nMoney)

	EH_SetCurDurability(nIdx, -1)

	Talk(1, "", 
		"Đã nâng cấp thành công!<enter><enter>"..
		"Trang bị <color=yellow>"..itemName.."<color> đã trở thành không thể phá hủy!"
	)

	Msg2Player("Trang bị đã trở thành không thể phá hủy.")
end

function GotoBLH()
	if (tbItemFeatureConfig:IsEnabled("starter", "teleport") ~= 1) then Msg2Player("Chuc nang nay dang tat."); return end
	local nW, nX, nY = GetWorldPos();
	if (nW == 246) then
	Msg2Player("Map này không thể sử dụng tính năng này!")
	return 1
	end
	if (nW == 53) then
		SetPos(1626,3179);
	else
		NewWorld(53, 1626, 3179);
	end
	SetFightState(0);
	Msg2Player("Di chuyển về <color=green>Ba Lăng Huyện<color> thành công!")
end

