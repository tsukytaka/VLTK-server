	{szName="Phong Vân Bạch Mã", tbProp={0,10,19,10,0,0}, nWidth=2, nHeight=3},
	{szName="Phong Vân Chiến Mã", tbProp={0,10,20,10,0,0}, nWidth=2, nHeight=3},
	{szName="Phong Vân Thần Mã", tbProp={0,10,21,10,0,0}, nWidth=2, nHeight=3},
	{szName="Ô Vân Đạp Tuyết", tbProp={0,10,5,6,0,0}, nWidth=2, nHeight=3},
	{szName="Xích Thố", tbProp={0,10,5,7,0,0}, nWidth=2, nHeight=3},
	{szName="Tuyệt ảnh", tbProp={0,10,5,8,0,0}, nWidth=2, nHeight=3},
	{szName="Đích Lô", tbProp={0,10,5,9,0,0}, nWidth=2, nHeight=3},
	{szName="Chiếu Dạ Ngọc Sư Tử", tbProp={0,10,5,10,0,0}, nWidth=2, nHeight=3},
	{szName="Phi Vân", tbProp={0,10,8,10,0,0}, nWidth=2, nHeight=3},
	{szName="Bôn Tiêu", tbProp={0,10,6,10,0,0}, nWidth=2, nHeight=3},
	{szName="Phiên Vũ", tbProp={0,10,7,10,0,0}, nWidth=2, nHeight=3},
};

function ThuCuoi(nPage)
	nPage = nPage or 1
	local nMaxOption = 10
	local tbTatCa = {}
	for i = 1, getn(TAB_THUCUOI) do
		tinsert(tbTatCa, TAB_THUCUOI[i])
	end
	for i = 1, getn(TAB_THUCUOI_HK_AN) do
		tinsert(tbTatCa, TAB_THUCUOI_HK_AN[i])
	end

	local tbOption = {}
	if nPage > 1 then
		tinsert(tbOption, {"Trở về trang trước", ThuCuoi, {nPage - 1}})
	end
	local nBatDau = nMaxOption * (nPage - 1) + 1
	local nKetThuc = nMaxOption * nPage
	if nKetThuc > getn(tbTatCa) then nKetThuc = getn(tbTatCa) end
	for i = nBatDau, nKetThuc do
		local tbMount = tbTatCa[i]
		if tbMount.nGoldIndex then
			tinsert(tbOption, {tbMount.szName, NhanThuCuoiHoangKimAn, {tbMount.nGoldIndex, tbMount.szName}})
		else
			tinsert(tbOption, {tbMount.szName, AddItemByTableCheckRoom, {tbMount}})
		end
	end
	if getn(tbTatCa) > nKetThuc then
		tinsert(tbOption, {"Đi đến trang kế", ThuCuoi, {nPage + 1}})
	end
	tinsert(tbOption, {"Kết thúc đối thoại."})
	CreateNewSayEx("<color=yellow>Nhận thú cưỡi<color>", tbOption)
end

TAB_THUCUOI_HK_AN = {
	{szName="Sư Tử", nGoldIndex=4480},
	{szName="Dương Sa", nGoldIndex=5093},
	{szName="Ngự Phong", nGoldIndex=5094},
	{szName="Truy Điện", nGoldIndex=5095},
	{szName="Lưu Tinh", nGoldIndex=5096},
}

function NhanThuCuoiHoangKimAn(nGoldIndex, szName)
	if CountFreeRoomByWH(2, 3) < 1 then
		Talk(1, "", "Cần ít nhất 2x3 ô trống trong hành trang.")
		return
	end
	local nItemIdx = AddGoldItem(0, nGoldIndex)
	if nItemIdx and nItemIdx > 0 then
		local szMagicLog = ""
		for i = 1, 6 do
			local nM, nP1, nP2, nP3 = GetItemMagicAttrib(nItemIdx, i)
			szMagicLog = szMagicLog.." ["..i..":"..tostring(nM)..","..tostring(nP1)..","..tostring(nP2)..","..tostring(nP3).."]"
		end
		WriteLog("[HiddenGoldMount-MAGIC] "..GetAccount().."	"..GetName().."	"..szName.."	"..nGoldIndex..szMagicLog)
		SyncItem(nItemIdx)
		Msg2Player("Nhận thành công "..szName..".")
		WriteLog("[HiddenGoldMount] "..GetAccount().."	"..GetName().."	"..szName.."	"..nGoldIndex)
	else
		Msg2Player("Không thể tạo thú cưỡi này; hệ thống không ghi vật phẩm lỗi.")
		WriteLog("[HiddenGoldMount-FAILED] "..GetAccount().."	"..GetName().."	"..szName.."	"..nGoldIndex)
	end
end
