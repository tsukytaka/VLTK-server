--===== Shop hỗ trợ =====---
function Shop_Support()
	local tbOpt =
	{
		{"Ta muốn mua Thần hành phù Thổ địa phù", Shop_Support_1},
		{"Ta muốn mua 40 Dã tẩu chi bảo", Shop_Support_2},
		{"Thoát"},
	}
	CreateNewSayEx("<color=yellow>Võ Lâm Truyền Kỳ 1 - 2009<color>:<enter>Shop ta mở bán cho đạo hữ đồng giá 1 lượng. Haha !", tbOpt)
end
function Shop_Support_1()
	if (GetCash() <= 2) then
		Talk(1, "", "Phải ca đủ 2 lượng mới ca thể mua.")
		return
	end
	if CalcFreeItemCellCount() < 2 then
		Say("Hãy cất bớt vật phẩm để đảm bảo có 2 ô trống rồi hãy tiếp tục nhé !",0);
		return 1;
	end
	Pay(2)
	local nTHPIndex = AddItem(6,1,1266,1,0,0,0)
	if nTHPIndex and nTHPIndex > 0 and ITEM_SetExpiredTime then
		ITEM_SetExpiredTime(nTHPIndex, 10080)
	end
	local nTDPIndex = AddItem(6,1,438,1,0,0,0)
	if nTDPIndex and nTDPIndex > 0 and ITEM_SetExpiredTime then
		ITEM_SetExpiredTime(nTDPIndex, 10080)
	end
end

function Shop_Support_2()
	if (GetCash() <= 400000) then
		Talk(1, "", "Phải ca đủ 400000 lượng mới ca thể mua.")
		return
	end
	if CalcFreeItemCellCount() < 2 then
		Say("Hãy cất bớt vật phẩm để đảm bảo có 2 ô trống rồi hãy tiếp tục nhé !",0);
		return 1;
	end
	Pay(400000)
	for i = 1, 40 do
		AddItem(6,1,4378,1,0,0,0)
	end;
end

