TAB_TANTHU_AN_SECT = {
	{"Thiếu Lâm", 1, 0},
	{"Thiên Vương", 2, 0},
	{"Đường Môn", 3, 1},
	{"Ngũ Độc", 4, 1},
	{"Nga My", 5, 2},
	{"Thúy Yên", 6, 2},
	{"Cái Bang", 7, 3},
	{"Thiên Nhẫn", 8, 3},
	{"Võ Đang", 9, 4},
	{"Côn Lôn", 10, 4},
}

TAB_TANTHU_AN_LEVEL = {
	{1, "Sơ Cấp"},
	{5, "Trung Cấp"},
	{10, "Cao Cấp"},
}

TAB_TANTHU_AN_HK = {
	{"Thiếu Lâm Hoàng Kim ấn", 1088},
	{"Thiên Vương Hoàng Kim ấn", 1089},
	{"Đường Môn Hoàng Kim ấn", 1090},
	{"Ngũ Độc Hoàng Kim ấn", 1091},
	{"Nga My Hoàng Kim ấn", 1092},
	{"Thúy Yên Hoàng Kim ấn", 1093},
	{"Cái Bang Hoàng Kim ấn", 1094},
	{"Thiên Nhẫn Hoàng Kim ấn", 1095},
	{"Võ Đang Hoàng Kim ấn", 1096},
	{"Côn Lôn Hoàng Kim ấn", 1097},
}

function tanthu_nhanan_main()
	local tbOpt = {
		{"ấn Tân Thủ", tanthu_nhanan_tanthu},
		{"Tất cả ấn Sơ Cấp", tanthu_nhanan_theocap, {1}},
		{"Tất cả ấn Trung Cấp", tanthu_nhanan_theocap, {5}},
		{"Tất cả ấn Cao Cấp", tanthu_nhanan_theocap, {10}},
		{"Tất cả Hoàng Kim ấn", tanthu_nhanan_hk_all},
		{"Chọn ấn môn phái", tanthu_nhanan_monphai},
		{"Chọn Hoàng Kim ấn", tanthu_nhanan_hk_menu},
		{"Quay lại", trangbiall},
		{"Thoát"},
	}
	CreateNewSayEx("<color=yellow>Nhận ấn<color>", tbOpt)
end

function tanthu_nhanan_tanthu()
	if CalcFreeItemCellCount() < 1 then
		Talk(1, "", "Hành trang không đủ 1 ô trống.")
		return
	end
	local nItemIdx = AddItem(0, 13, 0, 1, 0, 0, 0)
	if nItemIdx and nItemIdx > 0 then
		SyncItem(nItemIdx)
	end
	Msg2Player("Đã nhận ấn Tân Thủ.")
end

function tanthu_nhanan_theocap(nLevel)
	if CalcFreeItemCellCount() < getn(TAB_TANTHU_AN_SECT) then
		Talk(1, "", "Hành trang cần ít nhất "..getn(TAB_TANTHU_AN_SECT).." ô trống.")
		return
	end
	for i = 1, getn(TAB_TANTHU_AN_SECT) do
		local tbSect = TAB_TANTHU_AN_SECT[i]
		local nItemIdx = AddItem(0, 13, tbSect[2], nLevel, tbSect[3], 0, 0)
		if nItemIdx and nItemIdx > 0 then
			SyncItem(nItemIdx)
		end
	end
	Msg2Player("Đã nhận tất cả ấn cấp "..nLevel..".")
end

function tanthu_nhanan_monphai()
	local tbOpt = {}
	for i = 1, getn(TAB_TANTHU_AN_SECT) do
		tinsert(tbOpt, {TAB_TANTHU_AN_SECT[i][1], tanthu_nhanan_cap, {i}})
	end
	tinsert(tbOpt, {"Quay lại", tanthu_nhanan_main})
	tinsert(tbOpt, {"Thoát"})
	CreateNewSayEx("<color=yellow>Chọn môn phái nhận ấn<color>", tbOpt)
end

function tanthu_nhanan_cap(nSectIndex)
	local tbOpt = {}
	for i = 1, getn(TAB_TANTHU_AN_LEVEL) do
		local tbLevel = TAB_TANTHU_AN_LEVEL[i]
		tinsert(tbOpt, {TAB_TANTHU_AN_SECT[nSectIndex][1].." ấn - "..tbLevel[2], tanthu_nhanan_mot_an, {nSectIndex, tbLevel[1]}})
	end
	tinsert(tbOpt, {"Quay lại", tanthu_nhanan_monphai})
	tinsert(tbOpt, {"Thoát"})
	CreateNewSayEx("<color=yellow>Chọn cấp ấn<color>", tbOpt)
end

function tanthu_nhanan_mot_an(nSectIndex, nLevel)
	local tbSect = TAB_TANTHU_AN_SECT[nSectIndex]
	if not tbSect then
		return
	end
	if CalcFreeItemCellCount() < 1 then
		Talk(1, "", "Hành trang không đủ 1 ô trống.")
		return
	end
	local nItemIdx = AddItem(0, 13, tbSect[2], nLevel, tbSect[3], 0, 0)
	if nItemIdx and nItemIdx > 0 then
		SyncItem(nItemIdx)
		Msg2Player("Đã nhận "..tbSect[1].." ấn cấp "..nLevel..".")
	end
end

function tanthu_nhanan_hk_menu()
	local tbOpt = {}
	for i = 1, getn(TAB_TANTHU_AN_HK) do
		tinsert(tbOpt, {TAB_TANTHU_AN_HK[i][1], tanthu_nhanan_hk_one, {i}})
	end
	tinsert(tbOpt, {"Quay lại", tanthu_nhanan_main})
	tinsert(tbOpt, {"Thoát"})
	CreateNewSayEx("<color=yellow>Chọn Hoàng Kim ấn<color>", tbOpt)
end

function tanthu_nhanan_hk_one(nIndex)
	local tbAn = TAB_TANTHU_AN_HK[nIndex]
	if not tbAn then
		return
	end
	if CalcFreeItemCellCount() < 1 then
		Talk(1, "", "Hành trang không đủ 1 ô trống.")
		return
	end
	local nItemIdx = AddGoldItem(0, tbAn[2])
	if nItemIdx and nItemIdx > 0 then
		SyncItem(nItemIdx)
		Msg2Player("Đã nhận "..tbAn[1]..".")
	end
end

function tanthu_nhanan_hk_all()
	if CalcFreeItemCellCount() < getn(TAB_TANTHU_AN_HK) then
		Talk(1, "", "Hành trang cần ít nhất "..getn(TAB_TANTHU_AN_HK).." ô trống.")
		return
	end
	for i = 1, getn(TAB_TANTHU_AN_HK) do
		local nItemIdx = AddGoldItem(0, TAB_TANTHU_AN_HK[i][2])
		if nItemIdx and nItemIdx > 0 then
			SyncItem(nItemIdx)
		end
	end
	Msg2Player("Đã nhận tất cả Hoàng Kim ấn.")
end



TAB_TANTHU_TRANGSUC = {
	{"Trang Sức Tân Thủ", 1},
	{"Võ Lâm Trang Sức - Sơ Cấp", 2},
	{"Võ Lâm Trang Sức - Trung Cấp", 6},
	{"Võ Lâm Trang Sức - Cao Cấp", 10},
}

TAB_TANTHU_TRANGSUC_HK = {
	{"Võ Lâm Trang Sức Hoàng Kim", 1098},
	{"Tuyệt Đỉnh Trang Sức Hoàng Kim Sơ Cấp", 1109},
	{"Tuyệt Đỉnh Trang Sức Hoàng Kim Trung Cấp", 1110},
	{"Tuyệt Đỉnh Trang Sức Hoàng Kim Cao Cấp", 1111},
	{"Tuyệt Đỉnh Trang Sức Hoàng Kim Hoàn Mỹ", 1112},
}

function tanthu_nhantrangsuc_main()
	local tbOpt = {
		{"Trang Sức Tân Thủ", tanthu_nhantrangsuc_one, {1}},
		{"Võ Lâm Trang Sức - Sơ Cấp", tanthu_nhantrangsuc_one, {2}},
		{"Võ Lâm Trang Sức - Trung Cấp", tanthu_nhantrangsuc_one, {3}},
		{"Võ Lâm Trang Sức - Cao Cấp", tanthu_nhantrangsuc_one, {4}},
		{"Tất cả Trang Sức thường", tanthu_nhantrangsuc_all},
		{"Võ Lâm Trang Sức Hoàng Kim", tanthu_nhantrangsuc_hk_one, {1}},
		{"Tuyệt Đỉnh Trang Sức Hoàng Kim", tanthu_nhantrangsuc_hk_menu},
		{"Tất cả Trang Sức Hoàng Kim", tanthu_nhantrangsuc_hk_all},
		{"Quay lại", trangbiall},
		{"Thoát"},
	}
	CreateNewSayEx("<color=yellow>Nhận Trang Sức<color>", tbOpt)
end

function tanthu_nhantrangsuc_one(nIndex)
	local tbItem = TAB_TANTHU_TRANGSUC[nIndex]
	if not tbItem then
		return
	end
	if CalcFreeItemCellCount() < 1 then
		Talk(1, "", "Hành trang không đủ 1 ô trống.")
		return
	end
	local nItemIdx = AddItem(0, 14, 0, tbItem[2], 0, 0, 0)
	if nItemIdx and nItemIdx > 0 then
		SyncItem(nItemIdx)
		Msg2Player("Đã nhận "..tbItem[1]..".")
	end
end

function tanthu_nhantrangsuc_all()
	if CalcFreeItemCellCount() < getn(TAB_TANTHU_TRANGSUC) then
		Talk(1, "", "Hành trang cần ít nhất "..getn(TAB_TANTHU_TRANGSUC).." ô trống.")
		return
	end
	for i = 1, getn(TAB_TANTHU_TRANGSUC) do
		local tbItem = TAB_TANTHU_TRANGSUC[i]
		local nItemIdx = AddItem(0, 14, 0, tbItem[2], 0, 0, 0)
		if nItemIdx and nItemIdx > 0 then
			SyncItem(nItemIdx)
		end
	end
	Msg2Player("Đã nhận tất cả Trang Sức thường.")
end

function tanthu_nhantrangsuc_hk_menu()
	local tbOpt = {}
	for i = 2, getn(TAB_TANTHU_TRANGSUC_HK) do
		tinsert(tbOpt, {TAB_TANTHU_TRANGSUC_HK[i][1], tanthu_nhantrangsuc_hk_one, {i}})
	end
	tinsert(tbOpt, {"Quay lại", tanthu_nhantrangsuc_main})
	tinsert(tbOpt, {"Thoát"})
	CreateNewSayEx("<color=yellow>Tuyệt Đỉnh Trang Sức Hoàng Kim<color>", tbOpt)
end

