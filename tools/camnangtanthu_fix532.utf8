function TanThu_LoadPublicSupport()
	if (not StarterPublicSupport or not StarterPublicSupport.StartViemDe
		or not StarterPublicSupport.DoTrungSinh) then
		dofile("script/global/nobitaxd/npc/starter_public_support.lua")
	end
	if (not StarterPublicSupport or not StarterPublicSupport.StartViemDe
		or not StarterPublicSupport.DoTrungSinh) then
		Msg2Player("Khong tim thay chuc nang Cam nang Tan thu.")
		return 0
	end
	return 1
end

function TanThu_ViemDeMenu()
	if (TanThu_LoadPublicSupport() ~= 1) then return end
	local tbOpt = {
		{"Kích hoạt Viêm Đế", TanThu_AdminStartViemDe},
		{"Nhận Viêm Đế Lệnh", TanThu_AdminGiveViemDeLenh},
		{"Quay lại", HoTroTest},
		{"Thoát"},
	}
	CreateNewSayEx("Cẩm nang - Viêm Đế", tbOpt)
end

function TanThu_AdminStartViemDe()
	if (TanThu_LoadPublicSupport() ~= 1) then return end
	return StarterPublicSupport:StartViemDe()
end

function TanThu_AdminGiveViemDeLenh()
	if (TanThu_LoadPublicSupport() ~= 1) then return end
	return StarterPublicSupport:GiveViemDeLenh()
end

function TanThu_TrungSinhMenu()
	if (TanThu_LoadPublicSupport() ~= 1) then return end
	local nTrans = StarterPublicSupport:GetTransLifeCount()
	local tbOpt = {
		{"Trùng sinh 1", TanThu_AdminDoTrungSinh, {1}},
		{"Trùng sinh 2", TanThu_AdminDoTrungSinh, {2}},
		{"Trùng sinh 3", TanThu_AdminDoTrungSinh, {3}},
		{"Trùng sinh 4", TanThu_AdminDoTrungSinh, {4}},
		{"Trùng sinh 5", TanThu_AdminDoTrungSinh, {5}},
		{"Trùng sinh 6", TanThu_AdminDoTrungSinh, {6}},
		{"Trùng sinh 7", TanThu_AdminDoTrungSinh, {7}},
		{"Quay lại", HoTroTest},
		{"Thoát"},
	}
	CreateNewSayEx("Cẩm nang - Trùng sinh (hiện tại: "..nTrans..")", tbOpt)
end

function TanThu_AdminDoTrungSinh(nTarget)
	if (TanThu_LoadPublicSupport() ~= 1) then return end
	return StarterPublicSupport:DoTrungSinh(nTarget)
end

