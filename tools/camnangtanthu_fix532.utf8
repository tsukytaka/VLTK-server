function EventBaoDanh_QuaTang()
	local task_fanpage = GetTask(5800);
	if task_fanpage > 0 then
			Say("<color=fire>Đại hiệp Đại Hiệp Đã Nhận Rồi!", 0)
		return 1
	end

	local Name=GetName()
	if (Name == "LohasFlask") or (Name == "TLỄDatỄMa") or (Name == "ĐạiỄSưỄHuynh")	or (Name == "GameMaster")	or (Name == "PhụcỄHổỄLaỄHán")	or (Name == "OằnỄTàỄLàỄVằn")	or (Name == "AlanKhoa")		then 
		local tbItem = {
					{szName="L bao V Lâm Truyền K 1",	tbProp={6,1,4380,1,0,0},			nCount=1,nBindState=-2,	nExpiredTime=1440*60},
					{szName="Nhất K Càn Khôn Ph (30 Ngày)",		tbProp={6,1,4378,1,0,0},			nCount=1,nBindState=-2,	nExpiredTime=1440*60},
				}
		tbAwardTemplet:GiveAwardByList(tbItem, "báo danh facebook", 1)
		SetTask(5800,1)
		Msg2SubWorld("Đại Hiệp <color=yellow>"..GetName().."<color> đã nhận <color=green>Thưởng S Kiện Group Tr Chanh<color>. Thành công.");
	else 
		Talk(1, "", "Đại hiệp chưa báo danh, nên khuông c trong danh sách qu tặng lần này <color=yellow>Tại Group Tr Chanh - Chém Gi<color>.")
	end
end


