	function TrangBiTim2_Option()
		local tbOpt = {}
		for i=0, 9 do
			tinsert(tbOpt, format("%s/#TrangBiTim2_1(%d)", tbTrangBiTim2ItemName[i].szName, i))  
		end
		tinsert(tbOpt, "Trở lại./trangbiall")
		tinsert(tbOpt, "Kết thúc đối thoại./no")
		Say("Xin mời lựa chọn trang bị:", getn(tbOpt), tbOpt)	
	end
	function TrangBiTim2_1(nType)
		local tbEquip = %tbTrangBiTim2ItemName[nType]["tbEquip"]
		local tbOpt = {}
		for i=1, getn(tbEquip) do
			tinsert(tbOpt, format("%s/#TrangBiTim2_2(%d,%d)", tbEquip[i][1], i, nType))
		end
		tinsert(tbOpt, "Trở lại./TrangBiTim2_Option")
		tinsert(tbOpt, "Kết thúc đối thoại./no")
		Say("Xin mời lựa chọn trang bị:", getn(tbOpt), tbOpt)	
	end
	function TrangBiTim2_2(nIndex, nType)
		local szTitle = "Mời chọn hệ:"
		local tbOpt = {}
		tinsert(tbOpt, format("Kim/#TrangBiTim2_3(%d,%d, 0)",nIndex, nType))
		tinsert(tbOpt, format("Mộc/#TrangBiTim2_3(%d,%d, 1)",nIndex, nType))
		tinsert(tbOpt, format("Thủy/#TrangBiTim2_3(%d,%d, 2)",nIndex, nType))
		tinsert(tbOpt, format("Hỏa/#TrangBiTim2_3(%d,%d, 3)",nIndex, nType))
		tinsert(tbOpt, format("Thổ/#TrangBiTim2_3(%d,%d, 4)",nIndex, nType))
		tinsert(tbOpt, "Trở lại./TrangBiTim2_Option")
		tinsert(tbOpt, "Kết thúc đối thoại./no")
		Say(szTitle, getn(tbOpt), tbOpt)		
	end
	function TrangBiTim2_3(nIndex, nType, nSeries)
		local szTitle = "Mời chọn dòng hiện 1:"
		local tbOpt = {}
		tinsert(tbOpt, format("Tăng sát thương vật lý hệ Ngoại công/#TrangBiTim2_4(%d,%d,%d,10)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng công kích chính xác/#TrangBiTim2_4(%d,%d,%d,20)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng tốc độ xuất chiêu hệ Ngoại công/#TrangBiTim2_4(%d,%d,%d,30)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Bỏ qua tốc độ di chuyển của đối phương/#TrangBiTim2_4(%d,%d,%d,40)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Không thể phá hủy/#TrangBiTim2_4(%d,%d,%d,50)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng phòng thủ vật lý/#TrangBiTim2_4(%d,%d,%d,60)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng tốc độ di chuyển/#TrangBiTim2_4(%d,%d,%d,70)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng phản đòn cận chiến/#TrangBiTim2_4(%d,%d,%d,80)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Giảm thời gian bị thương/#TrangBiTim2_4(%d,%d,%d,90)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng phạm vi sát thương/#TrangBiTim2_4(%d,%d,%d,100)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Kỹ năng vốn có/#TrangBiTim2_4(%d,%d,%d,110)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Kháng tất cả/#TrangBiTim2_4(%d,%d,%d,120)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Trang sau/#TrangBiTim2_TrangSau(%d,%d,%d)",nIndex, nType, nSeries))
		tinsert(tbOpt, "Kết thúc đối thoại./no")
		Say(szTitle, getn(tbOpt), tbOpt)	
	end
	function TrangBiTim2_TrangSau(nIndex, nType, nSeries)
		local szTitle = "Mời chọn dòng hiện 1:"
		local tbOpt = {}
		tinsert(tbOpt, format("Hút sinh lực đối phương/#TrangBiTim2_4(%d,%d,%d,130)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Hút Nội lực đối phương/#TrangBiTim2_4(%d,%d,%d,140)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Sinh lực tăng/#TrangBiTim2_4(%d,%d,%d,150)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Nội lực tăng/#TrangBiTim2_4(%d,%d,%d,160)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Thể lực tăng/#TrangBiTim2_4(%d,%d,%d,170)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Mỗi nửa giây Sinh lực hồi phục/#TrangBiTim2_4(%d,%d,%d,180)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Mỗi nữa giây Nội lực hồi phục/#TrangBiTim2_4(%d,%d,%d,190)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Mỗi nữa giây Thể lực hồi phục/#TrangBiTim2_4(%d,%d,%d,200)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Sức mạnh tăng/#TrangBiTim2_4(%d,%d,%d,210)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng sát thương Vật lý hệ Ngoại công/#TrangBiTim2_4(%d,%d,%d,220)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng độc sát hệ Ngoại công/#TrangBiTim2_4(%d,%d,%d,230)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Tăng băng sát hệ Ngoại công/#TrangBiTim2_4(%d,%d,%d,240)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Trang sau/#TrangBiTim2_TrangKe(%d,%d,%d)",nIndex, nType, nSeries))
		tinsert(tbOpt, format("Trang trước/#TrangBiTim2_3(%d,%d,%d)",nIndex, nType, nSeries))
		tinsert(tbOpt, "Kết thúc đối thoại./no")
		Say(szTitle, getn(tbOpt), tbOpt)	
	end
	function TrangBiTim2_TrangKe(nIndex, nType, nSeries)
		local szTitle = "Mời chọn dòng hiện 1:"
		local tbOpt = {}
