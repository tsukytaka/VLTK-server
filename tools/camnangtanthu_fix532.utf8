function bkmp()
	local tbOpt = {
		{"Phái Thiếu Lâm",bkmp_phai,{1}}, {"Phái Thiên Vương",bkmp_phai,{2}},
		{"Phái Đường Môn",bkmp_phai,{3}}, {"Phái Ngũ Độc",bkmp_phai,{4}},
