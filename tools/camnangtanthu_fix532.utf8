function StarterGuide_Main(nSkipReload)
	if (nSkipReload ~= 1) then
		dofile("script/global/nobitaxd/npc/camnangtanthu.lua");
	end
	local nDate = tonumber(date("%Y%m%d%H%M"))
	if nDate <= ThoiGianHetHanDiemTP then
		Say("Đúng vào lúc <color=yellow>"..ThoiGianOpenStr.."<color> mới bắt đầu chính thức khai mở máy chủ");
		return 1
	end

	local nW, nX, nY = GetWorldPos()
	local year  = tonumber(date("%y"))
	local mm    = tonumber(date("%m"))
	local day   = tonumber(date("%d"))
	local hour  = tonumber(GetLocalDate("%H"))
	local mmin  = tonumber(GetLocalDate("%M"))

	--local nTTK    = GetTask(81)
	local nDochi  = GetTask(1027)
	local nDaTau  = tl_gettaskcourse() ~= 0 and tl_counttasklinknum(1) or 0	
	local nVinhDu = GetTask(2501)
	local nMayMan = GetLucky(0)

	local szTitle =
		"Nhân vật: <color=green>"..GetName().."<color>  Tài khoản: <color=green>"..GetAccount().."<color>\n"..
		"Thời gian: Ngày <color=yellow>"..day.."<color> Tháng <color=yellow>"..mm.."<color> Năm <color=yellow>20"..year.."<color>, <color=yellow>"..hour.."<color> giờ <color=yellow>"..mmin.."<color> phút\n"..
		"Tọa độ: <color=green>"..nW..", "..nX.."/"..nY.."<color>\n"..
		"Thần Bí Đồ Chí: <color=green>"..nDochi.."<color>\n"..
		"Nhiệm vụ Dã Tẩu đã hoàn thành : <color=green>"..nDaTau.."<color>\n"..
		"Chỉ số May mắn: <color=green>"..nMayMan.."<color> / Điểm Vinh Dự: <color=green>"..nVinhDu.."<color>"
		
	if (CFG_ChayThuNghiem == 0) then
		local tbOpt =
		{				
		{"Hỗ trợ làm nhiệm vụ nhanh", diadovolam},
		{"Hoan thanh nhanh Da Tau", TanThu_HoanThanhNhanhDaTau},
		{"Nhận kỹ năng", NhanSkill},
		{"Shop hỗ trợ", Shop_Support},
		{"Tạo nhóm quái luyện công", SummonMapMonsterGroup},
		{"Mộc nhân luyện công", TanThuMocNhan_Add},
		{"Thợ rèn đa năng", thorendanang},	
		{"Viêm Đế", TanThu_ViemDeMenu},
		{"Trùng sinh", TanThu_TrungSinhMenu},
		{"\078\104\203\110\032\077\198\116\032\078\185\032\045\032\086\105\112", TanThuMatNaKhacGiveOne, {592}},
		{"Nhận Nhẫn Thiên tử", TanThuNhanThienTu},
		{"Hủy bỏ mọi thứ", TanThu_DisposeItemMain},
		{"Hủy khóa vỉnh viễn", UnbindPermanentItem_Open},
		{"Thoát"},
		}
		CreateNewSayEx(szTitle, tbOpt)
	else
		local tbOpt =
		{			
		{"Gọi hoạt động Game nhanh", goihoatdongmaychu},
		{"Hỗ trợ làm Nhiệm vụ nhanh", diadovolam},		
		{"Hoan thanh nhanh Da Tau", TanThu_HoanThanhNhanhDaTau},
		{"Nhận kỹ năng", NhanSkill},
		{"Nhận hỗ trợ Test nhân vật", HoTroTest},
		{"Gọi SimCity", goisimcity},
		{"Tạo nhóm quái luyện công", SummonMapMonsterGroup},
		{"Mộc nhân luyện công", TanThuMocNhan_Add},
		{"Viêm Đế", TanThu_ViemDeMenu},
		{"Trùng sinh", TanThu_TrungSinhMenu},
		{"\078\104\203\110\032\077\198\116\032\078\185\032\045\032\086\105\112", TanThuMatNaKhacGiveOne, {592}},
		{"Nhận Nhẫn Thiên tử", TanThuNhanThienTu},
		{"Thợ rèn đa năng", thorendanang},	
		{"Hủy bỏ mọi thứ", TanThu_DisposeItemMain},
		{"Hủy khóa vỉnh viễn", UnbindPermanentItem_Open},
		{"Lấy thông tin NPC", LastNpcTalk},		
		{"Di chuyển về Ba Lăng Huyện", GotoBLH},
		--{"Thử nghiệm", LayDoRes},
		--{"KT Res", kiemtrares},		
		--{"Triệu tập đồng đội", GoiPTToiNoi},	
		{"Thoát"},
		--{"Đổi rác lấy vũ khí ngẫu nhiên", weapon_ring},
		}
		CreateNewSayEx(szTitle, tbOpt)
	end
	return 1
end
-- Hoan thanh nhanh nhiem vu Da Tau tu Cam nang Tan thu.
-- Nap truc tiep de tranh ham chua san sang do hang doi Include cua JX.
function TanThu_HoanThanhNhanhDaTau()
	dofile("script/global/mel/mission/datau.lua")
	if (type(lamnhiemvudatau) ~= "function") then
		Msg2Player("Khong tim thay chuc nang hoan thanh nhanh Da Tau.")
		return 0
	end
	return lamnhiemvudatau()
end

function main()
	return StarterGuide_Main(1)
end

-- Mo khoa truc tiep trang thai -2 tren instance, giu nguyen option va cap trang bi.
function UnbindPermanentItem_Open()
	GiveItemUI(
		"Huy khoa vinh vien",
		"Dat cac vat pham khoa vinh vien vao o ben duoi.<enter>Co the dat nhieu vat pham cung luc. Vat pham se duoc mo khoa va giu nguyen thuoc tinh.",
		"UnbindPermanentItem_OK",
		nil,
		1
	)
	return 1
end

function UnbindPermanentItem_OK(nCount)
	local nDone = 0
	local nSkip = 0
	for i = 1, nCount do
		local nItemIndex = GetGiveItemUnit(i)
		if (nItemIndex and nItemIndex > 0 and IsMyItem(nItemIndex) == 1) then
			local szItemName = GetItemName(nItemIndex)
			local nBindState = GetItemBindState(nItemIndex)
			if (nBindState == -2) then
				SetItemBindState(nItemIndex, 0)
				SyncItem(nItemIndex)
				if (GetItemBindState(nItemIndex) == 0) then
					WriteLog("ITEM_ADMIN_UNBIND	"..GetLocalDate("%Y-%m-%d %H:%M:%S").."	"..GetAccount().."	"..GetName().."	"..szItemName.."	"..GetItemGenTime(nItemIndex))
					nDone = nDone + 1
				else
					nSkip = nSkip + 1
				end
			else
				nSkip = nSkip + 1
			end
		else
			nSkip = nSkip + 1
		end
	end
	if (nDone > 0) then
		Msg2Player("Da huy khoa vinh vien "..nDone.." vat pham. Hay dong va mo lai hanh trang neu bieu tuong khoa chua cap nhat.")
		if (nSkip > 0) then
			Msg2Player("Bo qua "..nSkip.." vat pham khong phai khoa vinh vien hoac khong mo khoa duoc.")
		end
		return 1
	end
	Talk(1, "", "Khong co vat pham khoa vinh vien nao duoc mo khoa.")
	return 0
end

