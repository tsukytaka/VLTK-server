		if nItemIdx and nItemIdx > 0 then
			SetItemBindState(nItemIdx, 0);
			SyncItem(nItemIdx);
			nSuccess = nSuccess + 1;
		end
	end
	Msg2Player("Đã nhận "..nSuccess.." món "..tbPhiPhongName[nCap]..".");
	return 1;
end

