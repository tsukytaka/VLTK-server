---=====| {"Tẩy tủy nhanh", TayTuyNhanh} - Star |=====---
function TayTuyNhanh()
	local tbSay = {"Ngươi muốn tẩy tủy loại g đây?"}
		tinsert(tbSay, "Tăng điểm nhanh/tangdiemnhanh")
		tinsert(tbSay, "Tẩy điểm k năng/taydiemkynang")
		tinsert(tbSay, "Tẩy điểm tiềm năng/taydiemtiemnang")
		tinsert(tbSay, "Kết thúc đối thoại./OnCancel")
	CreateTaskSay(tbSay)
end

function taydiemkynang()
	Say("Ngươi đồng  Tẩy điểm k năng không?", 2, "Tẩy điểm k năng /taydiemkynangok","Không tẩy /OnCancel")
end

function taydiemkynangok()
	i = HaveMagic(210)
	j = HaveMagic(400)
	n = RollbackSkill()
	x = 0
	if (i ~= -1) then x = x + i end
	if (j ~= -1) then x = x + j end
	rollback_point = n - x
	if (rollback_point + GetMagicPoint() < 0) then
		rollback_point = -1 * GetMagicPoint()
	end
	AddMagicPoint(rollback_point)
	if (i ~= -1) then AddMagic(210,i) end
	if (j ~= -1) then AddMagic(400,j) end
	Msg2Player("Tẩy Tủy thành công! ngươi đã c th phân phối "..rollback_point.." điểm. ")
	Talk(1,"KickOutSelf","Tẩy Tủy thành công! ngươi đã c th phân phối "..rollback_point.." điểm.")
end

function taydiemtiemnang()
	Say("Ngươi đồng  tẩy điểm tiềm năng không?", 2, "Tẩy điểm tiềm năng/taydiemtiemnangok", "Không tẩy /OnCancel")
end

function taydiemtiemnangok()
	base_str = {35,20,25,30,20}
	base_dex = {25,35,25,20,15}
	base_vit = {25,20,25,30,25}
	base_eng = {15,25,25,20,40}
	player_series = GetSeries() + 1
	Utask88 = GetTask(88)
	AddStrg(base_str[player_series] - GetStrg(1) + GetByte(Utask88,1))
	AddDex(base_dex[player_series] - GetDex(1) + GetByte(Utask88,2))
	AddVit(base_vit[player_series] - GetVit(1) + GetByte(Utask88,3))
	AddEng(base_eng[player_series] - GetEng(1) + GetByte(Utask88,4))
end

function tangdiemnhanh()
	Say("Thích Minh: Ngươi muốn tăng điểm k năng nào?", 4,
		"Tăng Sức Mạnh/add_prop_str",
		"Tăng Thân Pháp/add_prop_dex",
		"Tăng Ngoại Công/add_prop_vit",
		"Tăng Nội Công/add_prop_eng")
end

function add_prop_str()
	AskClientForNumber("enter_str_num", 0, GetProp(), "Xin hãy nhập điểm s sức mạnh: ");
end

function add_prop_dex()
	AskClientForNumber("enter_dex_num", 0, GetProp(), "Xin hãy nhập điểm s thân pháp: ");
end

function add_prop_vit()
	AskClientForNumber("enter_vit_num", 0, GetProp(), "Xin hãy nhập điểm s ngoại công:");
end

function add_prop_eng()
	AskClientForNumber("enter_eng_num", 0, GetProp(), "Xin hãy nhập điểm s nội công: ");
end

function enter_str_num(n_key)
	if (n_key < 0 or n_key > GetProp()) then
		return
	end
	AddStrg(n_key);
end

function enter_dex_num(n_key)
	if (n_key < 0 or n_key > GetProp()) then
		return
	end
	AddDex(n_key);
end

function enter_vit_num(n_key)
	if (n_key < 0 or n_key > GetProp()) then
		return
	end
	AddVit(n_key);
end

function enter_eng_num(n_key)
	if (n_key < 0 or n_key > GetProp()) then
		return
	end
	AddEng(n_key);
end
function OnCancel()
end;
---=====| {"Tẩy tủy nhanh", TayTuyNhanh} - Star |=====---
---=====| {"Hủy b mọi th", TayTuyNhanh} - Star |=====---
function TanThu_DisposeItemMain()
	local tbOpt = {
		{"Hủy vật phẩm", TanThu_DisposeItemOpen},
		{"Hủy ngân lượng", DisposeMoney},
		{"Hủy kinh nghiệm", ExpRecall_Input},
		{"Quay lại", StarterGuide_Main, {1}},
		{"Thoát"},
	}
	CreateNewSayEx("<#> Đại hiệp muốn hủy vật gì?", tbOpt)
end

function DisposeItem_main()
	return TanThu_DisposeItemMain()
end

function TanThu_DisposeItemOpen()
	if (GetBoxLockState() ~= 0) then
		Say("Xin m khóa rương trước !", 0)
		return
	end
	GiveItemUI("Hủy vật phẩm", "Đặt vật phẩm cần hủy vào ô bên dưới. Có thể đặt nhiều vật phẩm cùng lúc.", "TanThu_DisposeConfirm", "onCancel", 1);
end

function TanThu_DisposeConfirm(nCount)
	local nDone = 0
	for i=1, nCount do
		local nItemIndex = GetGiveItemUnit(i)
		if (nItemIndex and nItemIndex > 0 and IsMyItem(nItemIndex) == 1) then
			local strItem = GetItemName(nItemIndex)
			RemoveItemByIndex(nItemIndex)
			nDone = nDone + 1
			WriteLog(date("%Y%m%d %H%M%S").."	".." GM Huy Item "..GetAccount().."	"..GetName().."	".." Huy item "..strItem)
		end
	end
	if (nDone > 0) then
		Talk(1, "", "Đã hủy "..nDone.." vật phẩm. Hãy kiểm tra lại hành trang.")
		Msg2Player("Đã hủy "..nDone.." vật phẩm thành công.")
	else
		Talk(1, "", "Không có vật phẩm nào được hủy.")
	end
end
---=====| {"Hủy b mọi th", TayTuyNhanh} - End |=====---


--===== H tr Item Event =====---
function itemEvent()
	local tbOpt =
	{
		{"Event Sinh Nhật V Lâm Truyền K", EventSNVLTK},
		{"Event Tết Nguyên Đán", EventTetNguyenDan},
		{"Event Giáng Sinh", EventNoel},
