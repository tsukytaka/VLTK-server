function nhanlv()
	local nCurLevel = GetLevel()
	if nCurLevel >= nlevel_test then
	--if nCurLevel >= 120 then
			Talk(1, "", "Ngươi đã đạt cấp "..nlevel_test.." rồi.")
		return
	end
	local nAddLevel = nlevel_test - nCurLevel
	--local nAddLevel = 120 - nCurLevel
	ST_LevelUp(nAddLevel)
end;

function dangcap200()
	AskClientForNumber("level",0,200,"Nhập Cấp Độ:") 
end

function level(num)
	local nCurLevel = GetLevel()
	local nAddLevel = num - nCurLevel
	ST_LevelUp(nAddLevel)
	Msg2Player("Bạn nhận được <color=yellow>"..num.."<color> cấp độ.") 
end

