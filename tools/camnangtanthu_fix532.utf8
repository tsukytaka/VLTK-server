	}
	CreateNewSayEx("Chọn loại Hội quán Thảo dược đơn:", tbOpt)
end

function NhanHoiQuanThaoDuocDonById(nDetail, szName)
	if (CalcFreeItemCellCount() < 1) then
		Talk(1, "", "Hành trang của bạn không đủ 1 ô trống.")
		return 0
	end
	local nItemIndex = AddItem(6,1,nDetail,1,0,0,0)
	if nItemIndex and nItemIndex > 0 then
		Msg2Player("Đã nhận "..szName..".")
		return 1
	end
	Msg2Player("Không thể nhận "..szName..".")
	return 0
end

function NhanHoiQuanThaoDuocDon()
	return NhanHoiQuanThaoDuocDonById(5000, "Hội quán Thảo dược đơn")
end

function NhanHoiQuanThaoDuocDonTrung()
	return NhanHoiQuanThaoDuocDonById(5001, "Hội quán Thảo dược đơn (trung)")
end

function NhanHoiQuanThaoDuocDonDai()
	return NhanHoiQuanThaoDuocDonById(5002, "Hội quán Thảo dược đơn (đại)")
end


