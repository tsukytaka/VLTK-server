function TanThu_Support()

	local nCurLevel = GetLevel()
	if nCurLevel > 1 then
		Talk(1,"","Không phải các h đã nhận <color=yellow>H Tr Tân Th<color>  ta một lần rồi sao?")
		return
	end
	if (CFG_HoTroTanThu	==	1) then
		HoTroTanThu()
		AddLeadExp(10000000)
	end
end

