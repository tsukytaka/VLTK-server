			{"Nâng Cấp Đồ Bạch Kim",bachkim_main},
			--{"Lọc Lại Option Trang Bị HKMP",LocOptionHKOK},
			{"Trùng Luyện Trang Bị Hoàng Kim Môn Phái",refine_HKMP},
			{"Trùng Luyện Trang Bị Trấn Bang Chi Bảo",refine_HanChe},
			{"Chế Tạo Đồ Phổ Hoàng Kim Môn Phái",ghepmanhhkmp},
			--{"Chế Tạo HKMP 2",GhepManhHKMP},
			{"Đổi Mảnh Hoàng Kim Môn Phái",XoayManhHKMP},
			--{"Nâng Cấp Thần Mã",pgHorseUpgradeMain},	
			{"Tăng Giảm Cấp Trang Bị ",TangGiamTrangBi},			
			{"Nâng Cấp Đồ Không Thể Phá Hủy",NangCapKhongThePhaHuy},			
